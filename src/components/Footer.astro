---
import Wordmark from "./Wordmark.astro";
import { site, addressLine } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Wordmark dark />
      <p>
        $500 websites for home-service businesses. Built before you pay, with no monthly fees.
      </p>
    </div>
    <div>
      <p class="footer__title">Contact</p>
      <ul>
        <li><a href={site.phone.href}>{site.phone.display}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{addressLine}</li>
      </ul>
    </div>
    <div>
      <p class="footer__title">Company</p>
      <ul>
        <li><a href="/#start">Build my site</a></li>
        <li><a href={site.demoUrl} target="_blank" rel="noopener">See a live example</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__title">Legal</p>
      <ul>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms and Conditions</a></li>
        <li><a href="/sms">SMS Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.legalEntity}.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    color: var(--on-dark-muted);
    padding: 64px 0 28px;
    font-size: 0.95rem;
  }

  .footer__grid {
    display: grid;
    gap: 36px;
  }

  @media (min-width: 800px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }

  .footer__brand p {
    margin-top: 16px;
    max-width: 320px;
  }

  .footer__title {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--on-dark);
    margin-bottom: 12px;
  }

  .footer ul {
    display: grid;
    gap: 8px;
  }

  .footer a {
    color: var(--on-dark-muted);
    text-decoration: none;
  }

  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer__bottom {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid rgb(255 255 255 / 10%);
    font-size: 0.85rem;
  }
</style>
