---
import type { Product } from "../data/products";
import Button from "./Button.astro";
import StatusPill from "./StatusPill.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="product-card">
  <div class="product-card__media" aria-hidden="true">
    <div class="product-card__logo-ph">{product.logoPlaceholder}</div>
    <div class="product-card__shot-ph">{product.screenshotPlaceholder}</div>
  </div>
  <div class="product-card__body">
    <div class="product-card__meta">
      <StatusPill variant="accent">D7 product</StatusPill>
    </div>
    <h3 class="product-card__name">{product.name}</h3>
    <p class="product-card__tagline">{product.tagline}</p>
    <p class="product-card__desc">{product.description}</p>
    <Button
      href={product.href}
      variant="secondary"
      external={product.external}
      event="product_link_clicked"
    >
      Visit product site
    </Button>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    background: linear-gradient(
      180deg,
      rgba(29, 41, 59, 0.9),
      rgba(20, 27, 36, 0.9)
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  @media (min-width: 640px) {
    .product-card {
      grid-template-columns: 1fr 1.2fr;
      align-items: center;
    }
  }

  .product-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(49, 206, 211, 0.08);
  }

  .product-card__media {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product-card__logo-ph,
  .product-card__shot-ph {
    display: grid;
    place-items: center;
    border: 1px dashed var(--color-border);
    border-radius: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    text-align: center;
    padding: 1rem;
    background: rgba(15, 20, 25, 0.5);
  }

  .product-card__logo-ph {
    min-height: 64px;
  }

  .product-card__shot-ph {
    min-height: 120px;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .product-card__name {
    font-size: var(--text-2xl);
  }

  .product-card__tagline {
    color: var(--color-text);
    font-weight: 500;
  }

  .product-card__desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }
</style>
