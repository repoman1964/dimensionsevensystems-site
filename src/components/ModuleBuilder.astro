---
import { systemComponents } from "../data/systems";
---

<div class="modules" role="list">
  {
    systemComponents.map((mod, i) => (
      <div class="module" role="listitem">
        <div class="module__index" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </div>
        <div class="module__body">
          <h3 class="module__title">{mod.label}</h3>
          <p class="module__desc">{mod.description}</p>
        </div>
        {i < systemComponents.length - 1 && (
          <div class="module__connector" aria-hidden="true" />
        )}
      </div>
    ))
  }
  <p class="modules__note">
    You don't get nine tools because we happen to sell nine tools. You get the pieces your conversion process actually needs.
  </p>
</div>

<style>
  .modules {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .modules {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .module {
    position: relative;
    display: flex;
    gap: 0.85rem;
    padding: 1.15rem 1.2rem;
    background: linear-gradient(
      180deg,
      rgba(29, 41, 59, 0.9),
      rgba(20, 27, 36, 0.9)
    );
    border: 1px solid var(--color-border);
    border-radius: 14px;
    transition:
      border-color var(--transition),
      transform var(--transition);
  }

  .module:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
  }

  .module__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-primary);
    flex-shrink: 0;
    padding-top: 0.15rem;
  }

  .module__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .module__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .module__connector {
    display: none;
  }

  .modules__note {
    grid-column: 1 / -1;
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    line-height: 1.55;
  }
</style>
