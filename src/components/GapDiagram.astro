---
import { journeyStages, journeyLeaks } from "../data/systems";
---

<div class="gap" role="img" aria-label="Customer journey from first search to review, with common gaps between steps">
  <div class="gap__track">
    {
      journeyStages.map((stage, i) => (
        <>
          <div class="gap__stage">
            <span class="gap__label">{stage.label}</span>
          </div>
          {i < journeyStages.length - 1 && (
            <div class="gap__connector">
              {journeyLeaks[i] && (
                <span
                  class:list={[
                    "gap__leak",
                    journeyLeaks[i].type === "warn" && "gap__leak--warn",
                  ]}
                >
                  {journeyLeaks[i].label}
                </span>
              )}
              <span class="gap__chevron" aria-hidden="true">›</span>
            </div>
          )}
        </>
      ))
    }
  </div>
</div>

<style>
  .gap {
    display: none;
  }

  @media (min-width: 1024px) {
    .gap {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  .gap__track {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    overflow: visible;
    padding: 1.25rem 0.75rem 1.35rem;
    gap: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: linear-gradient(
      180deg,
      rgba(29, 41, 59, 0.55),
      rgba(20, 27, 36, 0.85)
    );
  }

  /* Labels share a bottom rail with chevrons; text is vertically centered to the chevron */
  .gap__stage {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    min-width: 0;
    flex: 0 1 auto;
  }

  .gap__label {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.6rem;
    font-size: clamp(0.7rem, 1.05vw, 0.875rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
  }

  /*
    Connector stack:
      [pill]     ← line above
      [chevron]  ← bottom rail, vertically centered with labels
  */
  .gap__connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    flex: 1 1 0;
    min-width: 0;
  }

  .gap__chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.6rem;
    font-size: 3.6rem;
    font-weight: 300;
    line-height: 1;
    color: #ffffff;
    opacity: 1;
  }

  .gap__leak {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-error);
    background: rgba(255, 104, 104, 0.1);
    border: 1px solid rgba(255, 104, 104, 0.3);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    text-align: center;
    line-height: 1.25;
    white-space: nowrap;
    width: max-content;
    max-width: none;
  }

  .gap__leak--warn {
    color: var(--color-warning);
    background: rgba(242, 185, 59, 0.1);
    border-color: rgba(242, 185, 59, 0.3);
  }
</style>
