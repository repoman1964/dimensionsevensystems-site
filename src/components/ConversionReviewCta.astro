---
import Button from "./Button.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section
  class:list={["cr-cta", compact && "cr-cta--compact"]}
  aria-labelledby="cr-cta-heading"
>
  <div class="cr-cta__glow" aria-hidden="true"></div>
  <div class="cr-cta__inner">
    <div class="cr-cta__copy">
      <p class="cr-cta__eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Conversion Review
      </p>
      <h2 id="cr-cta-heading" class="cr-cta__heading">
        [PLACEHOLDER] See where opportunities are leaking — then fix the system
      </h2>
      <p class="cr-cta__desc">
        [PLACEHOLDER] A focused review of how leads and pipeline opportunities
        move through your business, where they stall, and what a practical
        conversion system would include.
      </p>
      <div class="cr-cta__lists">
        <div>
          <h3 class="cr-cta__list-title">What D7 reviews</h3>
          <ul>
            <li>[PLACEHOLDER] Lead capture and first response</li>
            <li>[PLACEHOLDER] Follow-up and booking paths</li>
            <li>[PLACEHOLDER] Pipeline visibility and handoffs</li>
            <li>[PLACEHOLDER] Tools currently in use</li>
          </ul>
        </div>
        <div>
          <h3 class="cr-cta__list-title">What you receive</h3>
          <ul>
            <li>[PLACEHOLDER] Map of conversion leaks</li>
            <li>[PLACEHOLDER] Priority fixes</li>
            <li>[PLACEHOLDER] System outline</li>
            <li>[PLACEHOLDER] Clear next steps</li>
          </ul>
        </div>
      </div>
      <div class="cr-cta__actions">
        <Button href="/conversion-review" event="conversion_review_started">
          Book a Conversion Review
        </Button>
        <Button href="mailto:hello@dimensionsevensystems.com" variant="secondary">
          Email us first
        </Button>
      </div>
    </div>
    {
      !compact && (
        <div class="cr-cta__visual" aria-hidden="true">
          <div class="cr-cta__report">
            <div class="cr-cta__report-bar">
              <span />
              <span />
              <span />
              <em>review · report preview</em>
            </div>
            <div class="cr-cta__report-body">
              <p class="mono">SYSTEM HEALTH</p>
              <div class="bar"><i style="width: 62%" /></div>
              <p class="mono warn">LEAK DETECTED · follow-up stage</p>
              <div class="rows">
                <div class="row ok">Capture · stable</div>
                <div class="row warn">Contact · delayed</div>
                <div class="row err">Follow-up · missing</div>
                <div class="row ok">Booking · partial</div>
              </div>
              <p class="mono accent">RECOVERABLE · opportunities in queue</p>
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .cr-cta {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius-card) + 4px);
    border: 1px solid var(--color-border);
    background: linear-gradient(
      160deg,
      #152033 0%,
      #0f1419 55%,
      #121c2a 100%
    );
    padding: 2rem 1.5rem;
  }

  @media (min-width: 768px) {
    .cr-cta {
      padding: 3rem;
    }
  }

  .cr-cta__glow {
    position: absolute;
    inset: -20% auto auto 50%;
    width: 70%;
    height: 60%;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse,
      rgba(73, 119, 247, 0.22),
      transparent 70%
    );
    pointer-events: none;
  }

  .cr-cta__inner {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .cr-cta:not(.cr-cta--compact) .cr-cta__inner {
      grid-template-columns: 1.2fr 0.9fr;
    }
  }

  .cr-cta__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .cr-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .cr-cta__heading {
    font-size: clamp(1.6rem, 3.5vw, 2.35rem);
    line-height: 1.15;
    max-width: 20ch;
  }

  .cr-cta__desc {
    color: var(--color-text-muted);
    max-width: 38rem;
    line-height: 1.65;
  }

  .cr-cta__lists {
    display: grid;
    gap: 1.25rem;
    width: 100%;
  }

  @media (min-width: 560px) {
    .cr-cta__lists {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cr-cta__list-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 0.6rem;
  }

  .cr-cta__lists ul {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cr-cta__lists li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .cr-cta__lists li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .cr-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .cr-cta__report {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg-elevated);
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
  }

  .cr-cta__report-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--color-border);
    background: rgba(15, 20, 25, 0.6);
  }

  .cr-cta__report-bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .cr-cta__report-bar span:nth-child(2) {
    background: #febc2e;
  }

  .cr-cta__report-bar span:nth-child(3) {
    background: #28c840;
  }

  .cr-cta__report-bar em {
    margin-left: auto;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cr-cta__report-body {
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin: 0;
  }

  .mono.warn {
    color: var(--color-warning);
  }

  .mono.accent {
    color: var(--color-accent);
  }

  .bar {
    height: 6px;
    border-radius: 99px;
    background: rgba(48, 74, 86, 0.6);
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    background: var(--gradient-brand);
    border-radius: inherit;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .row {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .row.ok {
    border-color: rgba(53, 212, 136, 0.3);
    color: var(--color-success);
  }

  .row.warn {
    border-color: rgba(242, 185, 59, 0.3);
    color: var(--color-warning);
  }

  .row.err {
    border-color: rgba(255, 104, 104, 0.3);
    color: var(--color-error);
  }
</style>
