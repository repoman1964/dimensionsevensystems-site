---
import type { CaseStudy } from "../data/case-studies";
import StatusPill from "./StatusPill.astro";
import TextLink from "./TextLink.astro";

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<article class:list={["case-card", study.featured && "case-card--featured"]}>
  <div class="case-card__top">
    <StatusPill>Placeholder</StatusPill>
    <span class="case-card__industry">{study.industry}</span>
  </div>
  <h3 class="case-card__title">{study.title}</h3>
  <p class="case-card__summary">{study.summary}</p>
  {
    study.featured && (
      <div class="case-card__details">
        <div>
          <span class="case-card__label">Problem</span>
          <p>{study.problem}</p>
        </div>
        <div>
          <span class="case-card__label">Approach</span>
          <p>{study.approach}</p>
        </div>
        <div>
          <span class="case-card__label">Outcome</span>
          <p>{study.outcome}</p>
        </div>
      </div>
    )
  }
  <div class="case-card__metrics">
    {
      study.metrics.map((m) => (
        <div class="case-card__metric">
          <span class="case-card__metric-value">{m.value}</span>
          <span class="case-card__metric-label">{m.label}</span>
        </div>
      ))
    }
  </div>
  <TextLink href="/our-work" event="case_study_opened">View details</TextLink>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: linear-gradient(
      180deg,
      rgba(29, 41, 59, 0.9),
      rgba(20, 27, 36, 0.9)
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    height: 100%;
    transition:
      border-color var(--transition),
      transform var(--transition);
  }

  .case-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
  }

  .case-card--featured {
    padding: 1.75rem;
  }

  .case-card__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .case-card__industry {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .case-card__title {
    font-size: var(--text-xl);
  }

  .case-card--featured .case-card__title {
    font-size: var(--text-2xl);
  }

  .case-card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .case-card__details {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    background: rgba(15, 20, 25, 0.45);
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .case-card--featured .case-card__details {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .case-card__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-faint);
    margin-bottom: 0.3rem;
  }

  .case-card__details p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .case-card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .case-card__metric {
    display: flex;
    flex-direction: column;
    min-width: 4.5rem;
  }

  .case-card__metric-value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .case-card__metric-label {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }
</style>
