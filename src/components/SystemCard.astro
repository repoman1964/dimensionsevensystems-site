---
import type { Service } from "../data/systems";
import TextLink from "./TextLink.astro";

interface Props {
  system: Service;
  featured?: boolean;
}

const { system, featured = false } = Astro.props;
---

<article class:list={["system-card", featured && "system-card--featured"]} id={system.id}>
  <h3 class="system-card__title">{system.name}</h3>
  <p class="system-card__problem">{system.problem}</p>
  <div class="system-card__io">
    <div>
      <span class="system-card__label">Before</span>
      <span>{system.input}</span>
    </div>
    <span class="system-card__arrow" aria-hidden="true">→</span>
    <div>
      <span class="system-card__label">After</span>
      <span>{system.output}</span>
    </div>
  </div>
  <ul class="system-card__components">
    {
      system.components.map((c) => (
        <li>{c}</li>
      ))
    }
  </ul>
  <TextLink href={system.href} event="service_card_opened">Learn more</TextLink>
</article>

<style>
  .system-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: linear-gradient(
      180deg,
      rgba(29, 41, 59, 0.9),
      rgba(20, 27, 36, 0.9)
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    height: 100%;
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .system-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(73, 119, 247, 0.08);
  }

  .system-card--featured {
    border-color: rgba(73, 119, 247, 0.35);
  }

  .system-card__title {
    font-size: var(--text-xl);
  }

  .system-card__problem {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    flex: 1;
  }

  .system-card__io {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.75rem 0.9rem;
    background: rgba(15, 20, 25, 0.55);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: var(--text-sm);
  }

  .system-card__io > div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .system-card__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .system-card__arrow {
    color: var(--color-accent);
    font-weight: 600;
  }

  .system-card__components {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .system-card__components li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.6rem;
  }
</style>
