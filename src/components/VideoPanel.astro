---
import { site } from "../data/site";
import Button from "./Button.astro";

interface Props {
  heading?: string;
  description?: string;
  label?: string;
  showCta?: boolean;
}

const {
  heading = "[PLACEHOLDER] Hear how D7 approaches conversion systems",
  description = site.founder.bio,
  label = "Founder video",
  showCta = true,
} = Astro.props;
---

<section class="video-panel" aria-labelledby="founder-video-heading">
  <div class="video-panel__media">
    <button
      type="button"
      class="video-panel__thumb"
      data-analytics="founder_video_started"
      aria-label="Play founder video (placeholder)"
    >
      <div class="video-panel__placeholder">
        <span class="video-panel__ph-label">[Founder image / video placeholder]</span>
        <span class="video-panel__play" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5.14v13.72L19 12 8 5.14z"></path>
          </svg>
        </span>
      </div>
    </button>
  </div>
  <div class="video-panel__content">
    <p class="video-panel__label">
      <span class="dot" aria-hidden="true"></span>
      {label}
    </p>
    <h2 id="founder-video-heading" class="video-panel__heading">{heading}</h2>
    <p class="video-panel__desc">{description}</p>
    {
      showCta && (
        <Button href="/conversion-review">Book a Conversion Review</Button>
      )
    }
  </div>
</section>

<style>
  .video-panel {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .video-panel {
      grid-template-columns: 1.35fr 1fr;
      gap: 3rem;
    }
  }

  .video-panel__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .video-panel__thumb:hover {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px rgba(73, 119, 247, 0.35),
      0 20px 50px rgba(73, 119, 247, 0.12);
  }

  .video-panel__placeholder {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(73, 119, 247, 0.15), transparent 55%),
      radial-gradient(ellipse at 70% 60%, rgba(49, 206, 211, 0.1), transparent 50%),
      var(--color-surface);
  }

  .video-panel__ph-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    text-align: center;
    padding: 1rem;
    max-width: 16rem;
  }

  .video-panel__play {
    position: absolute;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 12px 30px rgba(73, 119, 247, 0.35);
    transition: transform var(--transition), background var(--transition);
  }

  .video-panel__thumb:hover .video-panel__play {
    background: var(--color-primary-hover);
    transform: scale(1.05);
  }

  .video-panel__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .video-panel__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .video-panel__heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    max-width: 18ch;
  }

  .video-panel__desc {
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 36rem;
  }
</style>
