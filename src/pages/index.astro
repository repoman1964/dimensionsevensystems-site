---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SectionHeading from "../components/SectionHeading.astro";
import OperationsMonitor from "../components/OperationsMonitor.astro";
import GapDiagram from "../components/GapDiagram.astro";
import ProblemCard from "../components/ProblemCard.astro";
import ModuleBuilder from "../components/ModuleBuilder.astro";
import SystemCard from "../components/SystemCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import ContactCta from "../components/ContactCta.astro";
import { problems } from "../data/problems";
import { services, processSteps } from "../data/systems";
import { fitFor, notFitFor } from "../data/audiences";
import { faqs } from "../data/faqs";
import { site } from "../data/site";

const largeProblem = problems.find((p) => p.size === "large")!;
const mediumProblems = problems.filter((p) => p.size === "medium");
const compactProblems = problems.filter((p) => p.size === "compact");
---

<BaseLayout
  title={site.name}
  description={site.description}
>
  <!-- Section 1: Hero -->
  <section class="hero section" aria-labelledby="hero-heading">
    <div class="section-inner hero__grid">
      <div class="hero__copy">
        <Eyebrow>
          <span class="dot" aria-hidden="true"></span>
          Small business technology
        </Eyebrow>
        <h1 id="hero-heading" class="hero__title">
          Technology that works as hard as you do.
        </h1>
        <div class="hero__sub">
          <p>
            You started a business to do the work, not to wrestle with
            software, chase missed calls, or re-type the same information
            every night.
          </p>
          <p>
            Dimension Seven Systems helps small businesses put practical
            technology to work: websites, call handling, online booking,
            reminders, customer records, and simple automation, set up around
            how you already run your day.
          </p>
        </div>
        <div class="hero__actions">
          <Button href="/contact" event="hero_primary_cta_clicked">
            Get in touch
          </Button>
          <Button
            href="/services"
            variant="secondary"
            event="hero_secondary_cta_clicked"
          >
            See our services
          </Button>
        </div>
        <ul class="hero__trust">
          <li>Built around how you already work</li>
          <li>Connects to the tools you already use</li>
          <li>A real person to call when you need help</li>
        </ul>
      </div>
      <div class="hero__visual">
        <OperationsMonitor />
      </div>
    </div>
  </section>

  <!-- Section 2: The Gap -->
  <section class="section section--alt" aria-labelledby="gap-heading">
    <div class="section-inner">
      <SectionHeading
        eyebrow="The gap"
        title="Small gaps cost you customers and time."
      >
        <div class="gap-desc">
          <p>Every job follows the same path, from the first search to the final review.</p>
          <p>
            Each step is a place where things slip: a missed call, a game of
            phone tag, a forgotten appointment, an invoice that goes out late,
            or a happy customer who was never asked for a review.
          </p>
          <p>
            <strong>
              The right tools close those gaps without adding more work to your day.
            </strong>
          </p>
        </div>
      </SectionHeading>
      <GapDiagram />
    </div>
  </section>

  <!-- Section 3: Common problems -->
  <section class="section" aria-labelledby="fixes-heading">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Sound familiar?"
        title="Everyday problems technology can fix"
        description="Most small businesses don't need more software. They need the right few tools, set up properly."
      />
      <div class="problems-grid">
        <div class="problems-grid__featured">
          <ProblemCard problem={largeProblem} />
        </div>
        <div class="problems-grid__medium">
          {mediumProblems.map((p) => <ProblemCard problem={p} />)}
        </div>
        <div class="problems-grid__compact">
          {compactProblems.map((p) => <ProblemCard problem={p} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Building blocks -->
  <section class="section section--alt" aria-labelledby="components-heading">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Building blocks"
        title="What we can set up for you"
        description="Pick what you need. Each piece works on its own, and they work better together."
      />
      <ModuleBuilder />
    </div>
  </section>

  <!-- Section 5: How it works -->
  <section class="section" aria-labelledby="process-heading">
    <div class="section-inner">
      <SectionHeading
        eyebrow="How it works"
        title="Listen. Set it up. Show you how."
        description="We start with how your business runs today and change only what will make a real difference."
      />
      <ol class="process">
        {
          processSteps.map((step, i) => (
            <li class="process__step">
              <span class="process__num">{step.number}</span>
              <h3 class="process__title">{step.title}</h3>
              <p class="process__desc">{step.description}</p>
              {i < processSteps.length - 1 && (
                <div class="process__line" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
      <p class="process__note">
        No long contracts. No tech jargon. Just tools that make your day easier.
      </p>
    </div>
  </section>

  <!-- Section 6: Services -->
  <section class="section section--alt" aria-labelledby="systems-heading" id="services">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Services"
        title="Where most businesses start"
        description="Common starting points. Every setup is tailored to your business."
      />
      <div class="systems-bento">
        {
          services.map((service, i) => (
            <div class:list={["systems-bento__item", i === 0 && "systems-bento__item--wide"]}>
              <SystemCard system={service} featured={i === 0} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 7: Who it's for -->
  <section class="section" aria-labelledby="audience-heading">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Who we help"
        title="Built for small, hands-on businesses"
        description="If you're the one doing the work, answering the phone, and handling the paperwork, we can help."
      />
      <div class="audience">
        <div class="audience__fit">
          <h3 class="audience__heading">A good fit if you are…</h3>
          <ul class="audience__grid">
            {
              fitFor.map((item) => (
                <li class="audience__card">
                  <h4>{item.title}</h4>
                  <p>{item.description}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <aside class="audience__not">
          <h3 class="audience__heading audience__heading--not">Probably not for you</h3>
          <ul>
            {
              notFitFor.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- Section 8: Why D7 -->
  <section class="section section--alt" aria-labelledby="why-heading">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Why D7"
        title="Your options, side by side"
        description="Small businesses usually choose between these. Here's how we compare."
      />
      <ComparisonTable />
    </div>
  </section>

  <!-- Section 9: Contact CTA -->
  <section class="section">
    <div class="section-inner">
      <ContactCta />
    </div>
  </section>

  <!-- Section 10: FAQ -->
  <section class="section section--alt" aria-labelledby="faq-heading">
    <div class="section-inner faq-layout">
      <SectionHeading
        eyebrow="FAQ"
        title="Straight answers"
      />
      <FaqAccordion items={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-bg-deep);
  }

  /* Hero */
  .hero {
    padding-top: 2.5rem;
    min-height: calc(100vh - var(--header-h));
    display: flex;
    align-items: center;
  }

  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
    width: 100%;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.35rem;
  }

  .hero__title {
    font-size: var(--text-5xl);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .hero__title .text-gradient {
    display: inline;
  }

  .hero__sub {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 34rem;
  }

  .hero__sub p {
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 0.25rem;
  }

  .hero__trust li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  .hero__trust li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.8;
  }

  /* Gap section description */
  .gap-desc {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 40rem;
  }

  .gap-desc p {
    margin: 0;
  }

  .gap-desc strong {
    font-weight: 700;
    color: var(--color-text);
  }

  /* Problems editorial grid */
  .problems-grid {
    display: grid;
    gap: 1rem;
  }

  .problems-grid__medium {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .problems-grid__medium {
      grid-template-columns: 1fr 1fr;
    }
  }

  .problems-grid__compact {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .problems-grid__compact {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .problems-grid {
      grid-template-columns: 1.2fr 1fr;
      grid-template-rows: auto auto;
    }

    .problems-grid__featured {
      grid-row: 1 / 2;
    }

    .problems-grid__medium {
      grid-column: 2;
      grid-row: 1;
      grid-template-columns: 1fr;
    }

    .problems-grid__compact {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Process */
  .process {
    display: grid;
    gap: 1.5rem;
    counter-reset: none;
  }

  @media (min-width: 900px) {
    .process {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .process__step {
    position: relative;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: linear-gradient(
      180deg,
      rgba(29, 41, 59, 0.7),
      rgba(20, 27, 36, 0.85)
    );
  }

  .process__num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .process__title {
    font-size: var(--text-xl);
    margin-bottom: 0.65rem;
  }

  .process__desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .process__line {
    display: none;
  }

  @media (min-width: 900px) {
    .process__step:not(:last-child) .process__line {
      display: block;
      position: absolute;
      top: 2.25rem;
      right: -0.7rem;
      width: 1.4rem;
      height: 2px;
      background: var(--gradient-brand);
      opacity: 0.6;
      z-index: 1;
    }
  }

  .process__note {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    line-height: 1.55;
  }

  /* Systems bento */
  .systems-bento {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .systems-bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .systems-bento__item--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .systems-bento {
      grid-template-columns: repeat(3, 1fr);
    }

    .systems-bento__item--wide {
      grid-column: span 2;
    }
  }


  /* Audience */
  .audience {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .audience {
      grid-template-columns: 1.4fr 1fr;
      gap: 2rem;
      align-items: start;
    }
  }

  .audience__heading {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
    margin-bottom: 1rem;
  }

  .audience__heading--not {
    color: var(--color-warning);
  }

  .audience__grid {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 560px) {
    .audience__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .audience__card {
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-elevated);
  }

  .audience__card h4 {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .audience__card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .audience__not {
    padding: 1.5rem;
    border: 1px solid rgba(242, 185, 59, 0.25);
    border-radius: var(--radius-card);
    background: rgba(242, 185, 59, 0.04);
  }

  .audience__not ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .audience__not li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .audience__not strong {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .audience__not span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }


  .faq-layout {
    max-width: 800px;
  }

  .faq-layout :global(.section-heading) {
    margin-bottom: 1.5rem;
  }
</style>
