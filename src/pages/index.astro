---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import { site, trades } from "../data/site";

const pains = [
  {
    icon: "calendar",
    title: "It never changes after launch",
    body: "Months go by and your site looks exactly the same. Customers can't tell if you're still busy, or even still in business.",
  },
  {
    icon: "camera",
    title: "Your best jobs never make it online",
    body: "You do great work, but updating a website is a chore that never gets done. The photos stay in your phone, and customers never see them.",
  },
  {
    icon: "star",
    title: "Nothing shows you're active",
    body: "Customers are comparing a few names on Google. With no fresh work on your site, the competitor who looks busier gets the call.",
  },
] as const;

const features = [
  {
    icon: "camera",
    title: "Recent Jobs, posted from your phone",
    body: "Snap a few photos when a job's done and tap Post. We write the title and description, and it goes live on your site. Your site keeps getting fresher after every job.",
  },
  {
    icon: "phone",
    title: "Tap-to-call on every page",
    body: "Your number sits in the header on every page, one tap away on a phone.",
  },
  {
    icon: "clipboard",
    title: "Free-quote form up top",
    body: "Customers who won't call can request a quote from any page. It lands in your inbox.",
  },
  {
    icon: "message",
    title: "A message bubble",
    body: "Some people would rather text than talk. The bubble gives them a third way in.",
  },
  {
    icon: "calendar",
    title: "Pick-your-day requests",
    body: "Customers ask for a day and arrival window on the quote form at 11pm. You confirm, so you stay in control.",
  },
  {
    icon: "layers",
    title: "A page for every service",
    body: "Each service you offer gets its own page, so you match what people actually type into Google.",
  },
  {
    icon: "pin",
    title: "A page for every area you serve",
    body: "Neighborhood and city pages, written about the actual places you work.",
  },
  {
    icon: "star",
    title: "Your Google reviews, on your site",
    body: "Your best reviews sit right next to the quote button, where new customers are deciding.",
  },
  {
    icon: "shield",
    title: "Privacy and terms pages",
    body: "Nobody clicks them, but people notice when they're missing. Yours are included.",
  },
] as const;

const steps = [
  {
    title: "Tell us about your business",
    body: "60 seconds: your business name, trade, city and mobile number. No card, no contract.",
  },
  {
    title: "We build your site first",
    body: "Built from your Google listing and real reviews: your services, your areas, your number. Within 24 hours, we send you the link and a short video walking you through it.",
  },
  {
    title: "Love it? It's yours for $500",
    body: "Pay once through secure Stripe checkout. We take down the preview banner, connect your domain and make your changes. Don't love it? Walk away. You owe nothing.",
  },
] as const;

const included = [
  "Recent Jobs, posted from your phone, with the words written for you",
  "Complete multi-page website, built for your trade",
  "Tap-to-call, quote form and message bubble",
  "A page for every service and service area",
  "Your Google reviews on the site",
  "Pick-your-day quote requests",
  "Quote requests sent straight to your email",
  "Mobile-first design, privacy and terms pages",
  "Your domain connected (or we help you get one)",
  "Your list of changes made before launch",
  "Hosting included. No monthly fee, ever",
];

const compare = [
  { row: "Post jobs from your phone, words written for you", us: true, monthly: false, diy: false },
  { row: "Upfront price", us: "$500 once", monthly: "Often $0 to sign up", diy: "Free to start" },
  { row: "Monthly fee", us: "None", monthly: "Every month, for as long as you have it", diy: "Every month, plus your time" },
  { row: "See it finished before you pay", us: true, monthly: false, diy: false },
  { row: "Who builds it", us: "We do", monthly: "They do", diy: "You do, at night" },
  { row: "Page for every service and area", us: true, monthly: "Sometimes", diy: "If you write them" },
  { row: "Stop paying and it disappears", us: false, monthly: true, diy: true },
] as const;

const faqs = [
  {
    q: "Is $500 really everything?",
    a: "Yes. No setup fee, no premium tier, no monthly charge for hosting. The only possible extra is a domain name if you don't have one yet. Those cost about $10 to $20 a year and you pay the registrar directly, so it's in your name.",
  },
  {
    q: "Why would you build it before I pay?",
    a: "Because a website is hard to judge from a sales pitch. It's easy to judge when it's sitting on your phone with your name, your services and your reviews on it. If you don't want it, we take it down and you owe nothing.",
  },
  {
    q: "How is there no monthly fee?",
    a: "Your site is a fast, simple website served from Cloudflare's global network, not a bloated system that needs constant upkeep. It costs us very little to keep online, so we don't charge you rent for it.",
  },
  {
    q: "Do I own it?",
    a: "Yes. The site is yours, hosted in your own Cloudflare account, and your domain stays registered in your name. Your words, photos and reviews are yours too. Nothing locks you in: no contract, no cancellation fee.",
  },
  {
    q: "Can I update it myself?",
    a: "Your Recent Jobs, yes: take photos on your phone, tap Post, and the job goes up with the description written for you. For anything else, like new services, prices or hours, just call or text me.",
  },
  {
    q: "Will it get me to #1 on Google?",
    a: "Nobody honest can promise that. What you get is a site built the way Google likes: a real page for every service and every area you cover, fast on phones, with your reviews and fresh jobs on it. Rankings take time and depend on your competition.",
  },
  {
    q: "What do you need from me?",
    a: "Not much. We build from your Google Business Profile: your listing, services and reviews. After you buy, a short form collects your domain and anything you want changed.",
  },
  {
    q: "What if I don't have a Google Business Profile?",
    a: "Send the form anyway, or give me a call. I'll talk through what we can build from and help you set up a profile. Setting one up costs nothing, and you need one either way.",
  },
  {
    q: "How long does it take?",
    a: "Your site is usually ready to look at within 24 hours of your request. Once you buy, your changes go in and it goes live on your domain, usually the same week.",
  },
  {
    q: "Who am I dealing with?",
    a: `I'm ${site.founder.name}, the founder of ${site.name}, based in ${site.founder.location}. Call or text me at ${site.phone.display} and you'll reach a real person, not a ticket system.`,
  },
];
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__kicker">
          <span class="dot" aria-hidden="true"></span> For cleaners, landscapers, roofers and other home-service pros
        </p>
        <h1>A website that gets better <span>after every job.</span></h1>
        <p class="hero__sub">
          $500 one time. No monthly fees. Own it forever.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href="#start">Show me my site <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="hero__visual" aria-label="A Recent Jobs page on a CallCatcher Site, on desktop and phone">
        <div class="browser">
          <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>sweet-tea-demo.callcatcher.site</span></div>
          <img src="/demo/hero-desktop.webp" alt="Recent Jobs page on a CallCatcher Site, with a new Deep Cleaning job posted Tuesday" width="1440" height="900" fetchpriority="high" />
        </div>
        <div class="phone">
          <img src="/demo/hero-mobile.webp" alt="The same Recent Jobs page on a phone, with a tap-to-call button in the header" width="780" height="1688" fetchpriority="high" />
        </div>
        <div class="hero__tag">
          <Icon name="camera" />
          <div><strong>Every job, on your site</strong><span>Snap photos, tap Post, it's live</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRADES -->
  <section class="trades" aria-label="Trades we build for">
    <div class="trades__track">
      {[...trades, ...trades].map((t, i) => <span aria-hidden={i >= trades.length ? "true" : undefined}>{t}</span>)}
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The problem</span>
        <h2>Most contractor websites are stale from the day they launch.</h2>
        <p>
          Built once, never touched again. Customers searching Google want proof you're busy and good at what you do,
          and an old, empty site doesn't give them any.
        </p>
      </div>
      <div class="pains">
        {
          pains.map((p) => (
            <article class="pain">
              <span class="pain__icon"><Icon name={p.icon} /></span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section section--alt" id="whats-included">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">What's on every CallCatcher Site</span>
        <h2>Built to turn visitors into calls, quotes and booked jobs.</h2>
        <p>Not a pretty brochure. Every page is set up so a ready customer can reach you in one tap.</p>
      </div>
      <div class="features">
        {
          features.map((f) => (
            <article class="feature">
              <span class="feature__icon"><Icon name={f.icon} /></span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RECENT JOBS -->
  <section class="section" id="recent-jobs">
    <div class="container spotlight">
      <div class="spotlight__copy">
        <span class="eyebrow">Recent Jobs</span>
        <h2>Jobs get posted before you even leave the customer's driveway.</h2>
        <p class="spotlight__lead">
          Recent Jobs keeps your site fresh without any extra work. Take the photos you already take, and the job goes
          up on your site. You never write a word.
        </p>
        <ol class="spotlight__steps">
          <li><span>1</span><div><strong>Snap a few photos</strong> on your phone when the job's done.</div></li>
          <li><span>2</span><div><strong>Tap Post.</strong> We write the title and description for you.</div></li>
          <li><span>3</span><div><strong>It's live</strong> on your homepage, with its own page and neighborhood.</div></li>
        </ol>
        <p class="spotlight__note">
          <Icon name="shield" />
          If a photo looks wrong for your site, it catches it and asks you before anything goes up.
        </p>
      </div>
      <div class="spotlight__visual">
        <div class="browser browser--flat">
          <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>Recent Jobs</span></div>
          <img src="/demo/desktop-work.webp" alt="Recent Jobs page with photo cards labeled Today, 4 days ago and 5 days ago" width="1440" height="900" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--dark" id="how-it-works">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">How it works</span>
        <h2>See your finished site before you spend a dime.</h2>
        <p>Other companies ask you to pay first and hope it turns out. We do it the other way around.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="steps__cta">
        <a class="btn btn--primary btn--lg" href="#start">Start step 1 <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" id="pricing">
    <div class="container pricing">
      <div class="pricing__copy">
        <span class="eyebrow">Pricing</span>
        <h2>Pay once, yours forever.</h2>
        <p>
          No setup fees, no "pro plan," no hosting bill every month. You pay once, after you've seen it, and the site is
          yours.
        </p>
        <div class="math">
          <p class="math__title">Monthly fees, and you never own it.</p>
          <p>
            $100, $200, $300 a month for a website, forever. Stop paying and it disappears. That's renting, not owning.
          </p>
        </div>
        <div class="math">
          <p class="math__title">One job pays for it.</p>
          <p>
            Think about what one new customer is worth to you. A recurring cleaning client, one roof repair, a season of
            mowing. For most home-service businesses, <strong>a single extra job covers the whole $500.</strong> Every
            job after that is profit.
          </p>
        </div>
      </div>
      <div class="price-card">
        <p class="price-card__name">The CallCatcher Site</p>
        <p class="price-card__price"><span>$500</span> one time</p>
        <p class="price-card__sub">No monthly fees. Ever.</p>
        <ul>
          {included.map((item) => <li><Icon name="check" />{item}</li>)}
        </ul>
        <a class="btn btn--primary btn--lg" href="#start">Show me my site first</a>
        <p class="price-card__fine">You only pay if you want it, after you've seen it.</p>
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Compare</span>
        <h2>Rent it. Build it. Or own it today.</h2>
        <p>Rent somebody else's website forever, build one yourself someday, or own your own today for just $500, one time.</p>
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Feature</span></th>
              <th scope="col" class="compare__us">CallCatcher Site</th>
              <th scope="col">Monthly-fee website companies</th>
              <th scope="col">Do-it-yourself builders</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map((r) => (
                <tr>
                  <th scope="row">{r.row}</th>
                  {[r.us, r.monthly, r.diy].map((v, i) => (
                    <td class:list={{ compare__us: i === 0 }}>
                      {v === true ? (
                        <span class="yes"><Icon name="check" /><span class="visually-hidden">Yes</span></span>
                      ) : v === false ? (
                        <span class="no"><Icon name="x" /><span class="visually-hidden">No</span></span>
                      ) : (
                        v
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- LIVE EXAMPLE + FOUNDER -->
  <section class="section">
    <div class="container duo">
      <article class="example">
        <img src="/demo/mobile.webp" alt="" width="780" height="1688" loading="lazy" />
        <div>
          <span class="eyebrow">See a real one</span>
          <h2>Open a live CallCatcher Site on your phone.</h2>
          <p>
            Sweet Tea Cleaning Co. is a sample business, but the site is the real thing: tap-to-call, the quote form,
            service and area pages, reviews and Recent Jobs. Yours is built around your business, with your services,
            your service areas, your reviews and your jobs.
          </p>
          <a class="btn btn--ghost" href={site.demoUrl} target="_blank" rel="noopener">See a real CallCatcher Site <Icon name="external" /></a>
        </div>
      </article>
      <article class="founder">
        <span class="eyebrow">Who's behind it</span>
        <h2>A real person you can call.</h2>
        <p>
          I'm {site.founder.name}. I run {site.name} out of {site.founder.location}, and I build websites for the
          people who keep homes running: cleaners, lawn crews, roofers, painters, plumbers.
        </p>
        <p>
          I don't sell monthly plans or lock you into contracts. I build your site, show it to you, and if it's not
          right for your business, you don't pay. Simple as that.
        </p>
        <div class="founder__contact">
          <a class="btn btn--ghost" href={site.phone.href}><Icon name="phone" /> Call or text me: {site.phone.display}</a>
        </div>
      </article>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt" id="faq">
    <div class="container faq">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Straight answers.</h2>
        <p>Still have a question?<br />Call or text me <a href={site.phone.href}>{site.phone.display}</a>.</p>
      </div>
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- START -->
  <section class="section start" id="start">
    <div class="container start__grid">
      <div class="start__copy">
        <span class="eyebrow">See it before you pay</span>
        <h2>We build your site first, at no cost. You decide only after you see it.</h2>
        <ul class="start__list">
          <li><Icon name="check" /> Built from your Google listing and reviews</li>
          <li><Icon name="check" /> Link and walkthrough video sent to you within 24 hours</li>
          <li><Icon name="check" /> $500 one time, only if you want it</li>
          <li><Icon name="check" /> No monthly fees, no contract</li>
        </ul>
        <p class="start__call">
          Rather talk? Call or text me <a href={site.phone.href}>{site.phone.display}</a>.
        </p>
      </div>
      <div class="start__card">
        <LeadForm id="start-form" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: clamp(40px, 6vw, 80px) 0 clamp(56px, 7vw, 96px);
    background:
      radial-gradient(900px 500px at 85% 10%, var(--orange-soft), transparent 60%),
      radial-gradient(700px 500px at 0% 100%, var(--sky-soft), transparent 60%),
      var(--bg);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 56px;
    }
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-muted);
    margin-bottom: 22px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-soft);
    flex: none;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5.6vw, 4.1rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .hero h1 span {
    color: var(--orange);
  }

  .hero__sub {
    margin-top: 22px;
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    color: var(--ink-muted);
    max-width: 560px;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 24px;
    font-weight: 600;
  }

  .hero__badges li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero__badges :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--green);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 520px) {
    .hero__ctas .btn {
      width: 100%;
    }
  }

  .hero__visual {
    position: relative;
    padding: 0 0 40px;
  }

  .browser {
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #f1ede6;
    border-bottom: 1px solid var(--line);
  }

  .browser__bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .browser__bar span {
    margin-left: 10px;
    padding: 3px 12px;
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.75rem;
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero .browser {
    width: 88%;
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 30%;
    max-width: 200px;
    border-radius: 26px;
    padding: 7px;
    background: var(--navy);
    box-shadow: var(--shadow-lg);
  }

  .phone img {
    border-radius: 20px;
    aspect-ratio: 9 / 18;
    object-fit: cover;
    object-position: top;
  }

  .hero__tag {
    position: absolute;
    left: -6px;
    bottom: 6px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    max-width: 62%;
  }

  .hero__tag :global(svg) {
    flex: none;
    width: 38px;
    height: 38px;
    padding: 9px;
    border-radius: 10px;
    background: var(--green-soft);
    color: var(--green);
  }

  .hero__tag strong {
    display: block;
    font-family: var(--font-head);
    font-size: 0.95rem;
  }

  .hero__tag span {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  @media (max-width: 520px) {
    .hero__tag {
      display: none;
    }
  }

  /* Trades marquee */
  .trades {
    overflow: hidden;
    background: var(--navy);
    color: var(--on-dark);
    padding: 16px 0;
  }

  .trades__track {
    display: flex;
    gap: 48px;
    width: max-content;
    animation: marquee 50s linear infinite;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .trades__track span::before {
    content: "●";
    color: var(--orange);
    margin-right: 48px;
    font-size: 0.6em;
    vertical-align: middle;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trades__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
      gap: 12px 32px;
      padding-inline: 20px;
    }

    .trades__track span[aria-hidden] {
      display: none;
    }
  }

  /* Pains */
  .pains {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 860px) {
    .pains {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pain {
    padding: 30px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--orange);
  }

  .pain__icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--orange-soft);
    color: var(--orange);
    margin-bottom: 18px;
  }

  .pain__icon :global(svg) {
    width: 24px;
    height: 24px;
