---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactCta from "../components/ContactCta.astro";
import Button from "../components/Button.astro";
import { site, addressLine } from "../data/site";
---

<BaseLayout
  title="About"
  description="About Dimension Seven Systems, a small business technology provider in Acworth, Georgia: who we are, how we work, and what we do."
>
  <section class="section page-hero">
    <div class="section-inner about-hero">
      <div class="about-hero__copy">
        <SectionHeading
          eyebrow="About D7"
          title="Owner-operated, like you."
          description="Dimension Seven Systems helps small businesses use technology to save time, keep customers from slipping away, and run their day with less hassle."
        />
        <p class="about-hero__founder">
          <span class="avatar" aria-hidden="true">JM</span>
          <span>
            <strong>{site.founder.name}</strong>
            <span class="role">{site.founder.role}</span>
          </span>
        </p>
        <Button href="/contact">Get in touch</Button>
      </div>
      <div class="about-hero__panel">
        <dl class="about-card">
          <div>
            <dt>Business</dt>
            <dd>{site.name}</dd>
          </div>
          <div>
            <dt>Owner</dt>
            <dd>{site.legalName} (sole proprietor)</dd>
          </div>
          <div>
            <dt>Address</dt>
            <dd>{addressLine}</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={site.phone.href}>{site.phone.display}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner prose-block">
      <SectionHeading eyebrow="Why we exist" title="Good businesses shouldn't lose customers to busywork" />
      <div class="prose">
        <p>
          Most small business owners are excellent at their trade. They're
          busy doing the work, which means calls get missed, scheduling turns
          into phone tag, and paperwork piles up at night.
        </p>
        <p>
          The technology to fix this exists, and much of it is affordable. But
          picking the right tools, setting them up, and getting them to work
          together takes time most owners don't have. That's what we do.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner prose-block">
      <SectionHeading
        eyebrow="How we think"
        title="Find the real problem. Use the simplest tool that solves it."
      />
      <div class="prose">
        <p>
          A tool only earns a place in your business if it saves you time or
          keeps a customer from slipping away. If it doesn't, we leave it out.
        </p>
      </div>
      <ul class="principles">
        <li>
          <strong>Start with your day</strong>
          <span>We look at how you actually work before recommending anything.</span>
        </li>
        <li>
          <strong>Keep it simple</strong>
          <span>The fewest tools that get the job done, usable from your phone.</span>
        </li>
        <li>
          <strong>Use what works</strong>
          <span>If a tool you already have does the job, we connect to it.</span>
        </li>
        <li>
          <strong>Stay reachable</strong>
          <span>When you have a question, you talk to a real person.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <div class="does-grid">
        <div>
          <SectionHeading eyebrow="What we do" title="What D7 does" />
          <ul class="check-list">
            <li>Build websites for small businesses</li>
            <li>Set up call handling and missed-call replies</li>
            <li>Set up online booking and reminders</li>
            <li>Organize customer records and follow-up</li>
            <li>Connect apps and automate repetitive tasks</li>
          </ul>
        </div>
        <div>
          <SectionHeading eyebrow="What we don't" title="What D7 doesn't do" />
          <ul class="check-list check-list--not">
            <li>Sell contact or lead lists</li>
            <li>Send bulk or unsolicited marketing messages</li>
            <li>Lock you into long contracts</li>
            <li>Sell software you don't need</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <ContactCta compact />
    </div>
  </section>
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-bg-deep);
  }

  .page-hero {
    padding-top: 3rem;
  }

  .about-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-hero {
      grid-template-columns: 1.2fr 0.9fr;
    }
  }

  .about-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .about-hero__copy :global(.section-heading) {
    margin-bottom: 0;
  }

  .about-hero__founder {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--color-border-light);
    background: var(--color-bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }

  .about-hero__founder strong {
    display: block;
    font-size: var(--text-sm);
  }

  .about-hero__founder .role {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  .about-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 380px;
    margin: 0 auto;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background:
      radial-gradient(ellipse at 40% 30%, rgba(73, 119, 247, 0.12), transparent 60%),
      var(--color-bg-elevated);
  }

  .about-card dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
    margin-bottom: 0.2rem;
  }

  .about-card dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .about-card a {
    color: var(--color-primary-hover);
  }

  .prose-block {
    max-width: 720px;
  }

  .prose p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .principles {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .principles li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-elevated);
  }

  .principles strong {
    font-size: var(--text-sm);
  }

  .principles span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .does-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 800px) {
    .does-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .check-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .check-list li {
    position: relative;
    padding-left: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
  }

  .check-list--not li::before {
    background: var(--color-error);
  }
</style>
