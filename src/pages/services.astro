---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import GapDiagram from "../components/GapDiagram.astro";
import ModuleBuilder from "../components/ModuleBuilder.astro";
import SystemCard from "../components/SystemCard.astro";
import ProblemCard from "../components/ProblemCard.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import ContactCta from "../components/ContactCta.astro";
import Button from "../components/Button.astro";
import { services, processSteps } from "../data/systems";
import { problems } from "../data/problems";
import { faqs } from "../data/faqs";
---

<BaseLayout
  title="Services"
  description="Websites, call handling, online booking, reminders, customer records, follow-up, and custom tools for small businesses, set up by Dimension Seven Systems."
>
  <section class="section page-hero">
    <div class="section-inner page-hero__inner">
      <SectionHeading
        eyebrow="Services"
        title="Practical technology for the way you work"
        description="We set up the tools small businesses need to run day to day, connect them to what you already use, and show you how to use them."
      />
      <div class="page-hero__actions">
        <Button href="/contact">Get in touch</Button>
        <Button href="#services" variant="secondary">See services</Button>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Our approach"
        title="Simple tools, set up right"
        description="Technology should save you time, not create another job. Here's what that means in practice."
      />
      <div class="def-grid">
        <article class="def-card">
          <h3>What we do</h3>
          <ul>
            <li>Build websites that bring in calls</li>
            <li>Make sure every caller gets a response</li>
            <li>Let customers book and get reminders automatically</li>
            <li>Keep customer info in one place</li>
            <li>Automate the tasks you repeat every day</li>
          </ul>
        </article>
        <article class="def-card def-card--muted">
          <h3>What we avoid</h3>
          <ul>
            <li>Software you'll never use</li>
            <li>Long contracts</li>
            <li>Replacing tools that already work for you</li>
            <li>Tech jargon</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        eyebrow="The customer journey"
        title="Where things usually slip"
      />
      <GapDiagram />
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Building blocks"
        title="What we can set up"
        description="Chosen to fit your business, not sold as a bundle."
      />
      <ModuleBuilder />
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Problems we solve"
        title="Common problems we fix"
      />
      <div class="problems-compact">
        {problems.map((p) => <ProblemCard problem={{ ...p, size: "compact" }} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="services">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Services"
        title="Where most businesses start"
        description="Each setup is tailored after a short conversation. These are common starting points, not fixed packages."
      />
      <div class="arch-grid">
        {services.map((s) => <SystemCard system={s} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading eyebrow="Process" title="How working with us goes" />
      <ol class="engage">
        {
          processSteps.map((step) => (
            <li>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="engage-options">
        <h3>Ways to work with us</h3>
        <ul>
          <li>One-time setup of a single tool</li>
          <li>A complete setup across several tools</li>
          <li>Ongoing support and updates</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner faq-narrow">
      <SectionHeading eyebrow="FAQ" title="Common questions" />
      <FaqAccordion items={faqs} id="services-faq" />
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <ContactCta compact />
    </div>
  </section>
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-bg-deep);
  }

  .page-hero {
    padding-top: 3rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: -1rem;
  }

  .def-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .def-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .def-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-elevated);
  }

  .def-card h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .def-card--muted h3 {
    color: var(--color-text-faint);
  }

  .def-card ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .def-card li {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-left: 0.9rem;
    position: relative;
  }

  .def-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .problems-compact {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .problems-compact {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .problems-compact {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .arch-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .arch-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .arch-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .engage {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .engage li {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg-elevated);
  }

  .engage span {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .engage h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.4rem;
  }

  .engage p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .engage-options {
    padding: 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: 14px;
  }

  .engage-options h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
    margin-bottom: 0.75rem;
  }

  .engage-options li {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .faq-narrow {
    max-width: 800px;
  }
</style>
