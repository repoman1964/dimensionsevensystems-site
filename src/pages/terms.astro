---
import Legal from "../layouts/Legal.astro";
import { site } from "../data/site";

const toc = [
  { id: "agreement", label: "Agreement" },
  { id: "services", label: "Services" },
  { id: "preview", label: "Preview sites" },
  { id: "payment", label: "Price and payment" },
  { id: "sms", label: "Text messaging" },
  { id: "use", label: "Website use" },
  { id: "ip", label: "Ownership" },
  { id: "disclaimers", label: "Disclaimers" },
  { id: "liability", label: "Limitation of liability" },
  { id: "law", label: "Governing law" },
  { id: "changes", label: "Changes" },
  { id: "contact", label: "Contact" },
];
---

<Legal
  title="Terms and Conditions"
  description={`Terms and Conditions for ${site.name} and CallCatcher Sites.`}
  updated={site.legal.termsUpdated}
  toc={toc}
>
  <section id="agreement">
    <h2>Agreement</h2>
    <p>
      These Terms and Conditions apply to your use of {site.url} and to services provided by {site.legalEntity}
      (“{site.name}”, “D7”, “we”, “us”). By using this website or our services, you agree to these terms. If you do not
      agree, please do not use the site or services.
    </p>
  </section>

  <section id="services">
    <h2>Services</h2>
    <p>
      {site.name} builds websites for home-service businesses, sold as the “{site.product}.” Descriptions on this
      website are informational and are not a binding offer. What a site includes is described on our homepage at the
      time you buy.
    </p>
  </section>

  <section id="preview">
    <h2>Preview sites</h2>
    <p>
      When you ask us to, we build a preview of a website for your business from information your business has made
      public, such as your Google Business Profile and customer reviews. A preview is free, carries a preview banner,
      and you are under no obligation to buy it. If you don't want it, tell us and we will take it down.
    </p>
  </section>

  <section id="payment">
    <h2>Price and payment</h2>
    <p>
      The {site.product} is a one-time payment of {site.price}, paid through Stripe after you have seen your preview.
      There is no monthly fee for hosting the site. A domain name, if you need one, is bought from a domain registrar
      in your name and paid to them directly. After payment we remove the preview banner, connect your domain, and make
      the changes you list in your welcome form before the site goes live as yours. Later changes are handled on
      request.
    </p>
  </section>

  <section id="sms">
    <h2>Text messaging</h2>
    <p>
      If you agree to receive text messages from {site.name}, our <a href="/sms">SMS Terms</a> apply and are part of
      these terms. In short: message frequency varies; message and data rates may apply; reply STOP to opt out and HELP
      for help; carriers are not liable for delayed or undelivered messages; and agreeing to receive texts is never a
      condition of purchase.
    </p>
  </section>

  <section id="use">
    <h2>Website use</h2>
    <p>
      You agree not to misuse the website, attempt unauthorized access, or use it for any unlawful purpose. We may
      update or discontinue parts of the website at any time.
    </p>
  </section>

  <section id="ip">
    <h2>Ownership</h2>
    <p>
      The content and branding on this website belong to {site.name} unless otherwise noted. Your business name, logo,
      photos, reviews, and the words written about your business on a site you buy are yours. Your domain stays
      registered in your name.
    </p>
  </section>

  <section id="disclaimers">
    <h2>Disclaimers</h2>
    <p>
      This website and our services are provided “as is.” We do not guarantee any specific business results, search
      rankings, number of calls, or revenue. The example site shown on this website is for a fictional business.
    </p>
  </section>

  <section id="liability">
    <h2>Limitation of liability</h2>
    <p>
      To the fullest extent permitted by law, {site.name} is not liable for indirect, incidental, or consequential
      damages arising from your use of this website or our services, and our total liability for any claim is limited
      to the amount you paid us.
    </p>
  </section>

  <section id="law">
    <h2>Governing law</h2>
    <p>These terms are governed by the laws of the State of Georgia, United States.</p>
  </section>

  <section id="changes">
    <h2>Changes</h2>
    <p>We may update these terms from time to time. The “Last updated” date at the top shows when they were last changed.</p>
  </section>
</Legal>
