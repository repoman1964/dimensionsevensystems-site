---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import ProductCard from "../components/ProductCard.astro";
import ConversionReviewCta from "../components/ConversionReviewCta.astro";
import StatusPill from "../components/StatusPill.astro";
import { caseStudies, testimonials } from "../data/case-studies";
import { products } from "../data/products";
import { featuredSystems } from "../data/systems";

const featured = caseStudies.find((c) => c.featured)!;
const rest = caseStudies.filter((c) => !c.featured);
---

<BaseLayout
  title="Our Work"
  description="[PLACEHOLDER] Conversion system examples, demonstrations, and D7 product work. Case studies will appear as client work ships."
>
  <section class="section page-hero">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Our work"
        title="Systems, not slide decks"
        description="[PLACEHOLDER] We are pre-revenue. This page is structured for real case studies, before/after workflows, and demonstrations — without inventing results."
      />
      <p class="prerevenue">
        <StatusPill variant="warning">Pre-revenue</StatusPill>
        <span>No client names, testimonials, or performance metrics until we have permission and real outcomes.</span>
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <SectionHeading eyebrow="Featured" title="Featured case study structure" />
      <CaseStudyCard study={featured} />
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Library"
        title="Project & system grid"
        description="[PLACEHOLDER] Filtering will activate when there are enough projects. Structure is ready."
      />
      <div class="filters" aria-label="Filters (inactive until more projects exist)">
        <span class="filters__label">Filter</span>
        <button type="button" class="filters__chip is-active" disabled>All</button>
        <button type="button" class="filters__chip" disabled>Systems</button>
        <button type="button" class="filters__chip" disabled>Products</button>
        <button type="button" class="filters__chip" disabled>Workflows</button>
      </div>
      <div class="work-grid">
        {rest.map((s) => <CaseStudyCard study={s} />)}
        {
          featuredSystems.slice(0, 3).map((sys) => (
            <article class="demo-card">
              <StatusPill variant="info">Demonstration</StatusPill>
              <h3>{sys.name}</h3>
              <p>{sys.problem}</p>
              <p class="demo-card__io">
                <span>{sys.input}</span>
                <span aria-hidden="true">→</span>
                <span>{sys.output}</span>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <SectionHeading
        eyebrow="Before & after"
        title="Workflow placeholders"
        description="[PLACEHOLDER] Side-by-side process maps will live here once we have documentable engagements."
      />
      <div class="ba-grid">
        <div class="ba-card">
          <h3>Before</h3>
          <p>[PLACEHOLDER] Fragmented capture, slow response, no follow-up ownership, opaque pipeline.</p>
        </div>
        <div class="ba-card ba-card--after">
          <h3>After</h3>
          <p>[PLACEHOLDER] Routed capture, timed response, sequenced follow-up, measurable stages.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="products">
    <div class="section-inner">
      <SectionHeading
        eyebrow="D7 products"
        title="Owned tools in the stack"
      />
      <div class="products">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <SectionHeading eyebrow="Testimonials" title="What clients say" />
      <div class="testimonials">
        {
          testimonials.map((t) => (
            <blockquote class="testimonial">
              <p>{t.quote}</p>
              <footer>
                <cite>{t.name}</cite>
                <span>{t.role}</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <ConversionReviewCta compact />
    </div>
  </section>
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-bg-deep);
  }

  .page-hero {
    padding-top: 3rem;
  }

  .prerevenue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: -1rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 40rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filters__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    margin-right: 0.35rem;
  }

  .filters__chip {
    min-height: 36px;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-faint);
    opacity: 0.7;
    cursor: not-allowed;
  }

  .filters__chip.is-active {
    border-color: var(--color-primary);
    color: var(--color-text);
    opacity: 1;
  }

  .work-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .demo-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-elevated);
  }

  .demo-card h3 {
    font-size: var(--text-lg);
  }

  .demo-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .demo-card__io {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs) !important;
    color: var(--color-accent) !important;
  }

  .ba-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .ba-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ba-card {
    padding: 1.5rem;
    border: 1px solid rgba(255, 104, 104, 0.25);
    border-radius: var(--radius-card);
    background: rgba(255, 104, 104, 0.04);
  }

  .ba-card--after {
    border-color: rgba(53, 212, 136, 0.25);
    background: rgba(53, 212, 136, 0.04);
  }

  .ba-card h3 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    color: var(--color-error);
  }

  .ba-card--after h3 {
    color: var(--color-success);
  }

  .ba-card p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .products {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .testimonials {
    display: grid;
    gap: 1rem;
  }

  .testimonial {
    margin: 0;
    padding: 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-elevated);
  }

  .testimonial p {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .testimonial footer {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .testimonial cite {
    font-style: normal;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .testimonial span {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }
</style>
