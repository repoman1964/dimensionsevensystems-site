---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FormField from "../components/FormField.astro";
import Button from "../components/Button.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { contactFaqs } from "../data/faqs";
import { site, addressLine } from "../data/site";

/** Set ?campaign=1 to render with a minimal header */
const campaign = Astro.url.searchParams.get("campaign") === "1";
---

<BaseLayout
  title="Contact"
  description="Contact Dimension Seven Systems for help with websites, call handling, online booking, reminders, and other technology for your small business."
  minimalHeader={campaign}
>
  <section class="section review-hero">
    <div class="section-inner review-hero__grid">
      <div>
        <SectionHeading
          eyebrow="Contact"
          title="Let's talk about your business"
          description="Tell us a little about how you work today and what's slowing you down. We'll get back to you within one business day."
        />
        <ul class="review-points">
          <li>
            <strong>Phone</strong>
            <span><a href={site.phone.href}>{site.phone.display}</a></span>
          </li>
          <li>
            <strong>Email</strong>
            <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
          </li>
          <li>
            <strong>Address</strong>
            <span>{addressLine}</span>
          </li>
        </ul>
      </div>

      <div class="review-form-card" id="contact-form">
        <h2 class="review-form-card__title">Send us a message</h2>
        <p class="review-form-card__sub">
          Fields marked with * are required.
        </p>
        <form
          class="review-form"
          method="POST"
          action="/api/contact"
          data-contact-form
          data-analytics-form="contact"
          novalidate
        >
          <FormField
            label="Name"
            name="name"
            required
            autocomplete="name"
            placeholder="Your name"
          />
          <FormField
            label="Email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@yourbusiness.com"
          />
          <FormField
            label="Business name"
            name="company"
            required
            autocomplete="organization"
            placeholder="Business name"
          />
          <FormField
            label="Phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="(555) 555-5555"
          />
          <FormField
            label="What would you like help with?"
            name="topic"
            type="select"
            required
            options={[
              { value: "website", label: "A website" },
              { value: "calls", label: "Calls and missed calls" },
              { value: "scheduling", label: "Scheduling and reminders" },
              { value: "follow-up", label: "Customer follow-up" },
              { value: "records", label: "Organizing customer info" },
              { value: "other", label: "Something else / not sure" },
            ]}
          />
          <FormField
            label="Anything else we should know?"
            name="message"
            type="textarea"
            rows={3}
            placeholder="Optional"
          />
          <div class="sms-consent">
            <input
              type="checkbox"
              id="field-sms_consent"
              name="sms_consent"
              value="yes"
            />
            <label for="field-sms_consent">
              Optional: By checking this box, I agree to receive text messages
              from {site.name} at the phone number provided about my inquiry,
              including replies, appointment scheduling, and links to
              information I request. Message frequency varies. Message and data
              rates may apply. Reply STOP to opt out or HELP for help. Consent
              is not a condition of purchase. See our{" "}
              <a href="/sms">SMS Terms</a> and <a href="/privacy">Privacy Policy</a>.
            </label>
          </div>
          <p class="form-field__error" data-error-for="sms_consent" hidden></p>
          <p class="review-form__privacy">
            By submitting, you agree we may contact you by email or phone about
            this request. See our <a href="/privacy">Privacy Policy</a>.
          </p>
          <div class="review-form__status" data-form-status role="status" aria-live="polite" hidden></div>
          <Button type="submit" fullWidth event="contact_submitted">
            Send message
          </Button>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner expectations">
      <SectionHeading eyebrow="What happens next" title="What to expect" />
      <ol>
        <li>We read your message and reply within one business day.</li>
        <li>We set up a short call to learn how your business runs.</li>
        <li>You get a simple plan and a clear price, with no pressure and no obligation.</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="section-inner faq-narrow">
      <SectionHeading eyebrow="FAQ" title="Common questions" />
      <FaqAccordion items={contactFaqs} id="contact-faq" />
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner privacy-note">
      <p>
        <strong>Privacy</strong>{" "}
        We use your details only to respond to your request. We never sell or
        share your information, including your phone number and text messaging
        consent, with third parties for their marketing.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      // Clear prior errors
      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
        el.hidden = true;
        el.textContent = "";
      });

      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const company = String(data.get("company") || "").trim();
      const topic = String(data.get("topic") || "").trim();
      const phone = String(data.get("phone") || "").trim();
      const smsConsent = data.get("sms_consent") === "yes";

      let valid = true;
      const setError = (field: string, msg: string) => {
        const el = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (el) {
          el.textContent = msg;
          el.hidden = false;
        }
        valid = false;
      };

      if (!name) setError("name", "Name is required.");
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError("email", "A valid email is required.");
      }
      if (!company) setError("company", "Business name is required.");
      if (!topic) setError("topic", "Please choose an option.");
      if (smsConsent && !phone) {
        setError("sms_consent", "Enter a phone number to receive text messages.");
      }

      if (!valid) return;

      if (btn) btn.disabled = true;
      if (status) {
        status.hidden = false;
        status.textContent = "Sending…";
        status.className = "review-form__status";
      }

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: data,
        });
        const json = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
        };

        if (!res.ok || !json.ok) {
          throw new Error(json.message || "Something went wrong. Please email us directly.");
        }

        if (status) {
          status.textContent =
            json.message || "Message received. We'll be in touch within one business day.";
          status.className = "review-form__status is-success";
        }
        form.reset();

        const w = window as Window & { d7Analytics?: unknown[] };
        w.d7Analytics = w.d7Analytics || [];
        w.d7Analytics.push({ event: "contact_submitted" });
      } catch (err) {
        if (status) {
          status.textContent =
            err instanceof Error
              ? err.message
              : "Could not send. Please email hello@dimensionsevensystems.com instead.";
          status.className = "review-form__status is-error";
        }
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>

<style>
  .section--alt {
    background: var(--color-bg-deep);
  }

  .review-hero {
    padding-top: 3rem;
  }

  .review-hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .review-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .review-points {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: -0.5rem;
  }

  .review-points li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-elevated);
  }

  .review-points strong {
    font-size: var(--text-sm);
  }

  .review-points span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .review-form-card {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-card) + 2px);
    background: linear-gradient(
      180deg,
      rgba(29, 41, 59, 0.95),
      rgba(20, 27, 36, 0.98)
    );
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.25);
  }

  .review-form-card__title {
    font-size: var(--text-xl);
    margin-bottom: 0.4rem;
  }

  .review-form-card__sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .review-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .review-form__privacy {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    line-height: 1.5;
  }

  .sms-consent {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
  }

  .sms-consent input {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    accent-color: var(--color-primary);
  }

  .sms-consent label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .review-form > .form-field__error {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-error);
  }

  .sms-consent a,
  .review-points a {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  .review-form__privacy a {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  .review-form__status {
    font-size: var(--text-sm);
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    background: rgba(73, 119, 247, 0.1);
    border: 1px solid rgba(73, 119, 247, 0.3);
    color: var(--color-text-muted);
  }

  .review-form__status.is-success {
    background: rgba(53, 212, 136, 0.1);
    border-color: rgba(53, 212, 136, 0.35);
    color: var(--color-success);
  }

  .review-form__status.is-error {
    background: rgba(255, 104, 104, 0.1);
    border-color: rgba(255, 104, 104, 0.35);
    color: var(--color-error);
  }


  .expectations {
    max-width: 640px;
  }

  .expectations ol {
    list-style: decimal;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .expectations li {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
    padding-left: 0.35rem;
  }

  .faq-narrow {
    max-width: 720px;
  }

  .privacy-note {
    max-width: 640px;
  }

  .privacy-note p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-elevated);
  }
</style>
