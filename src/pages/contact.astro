---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import { site, addressLine } from "../data/site";
---

<Base title="Contact" description={`Call, text, or email ${site.name}, or ask us to build your CallCatcher Site free.`}>
  <section class="section contact">
    <div class="container contact__grid">
      <div>
        <span class="eyebrow">Contact</span>
        <h1>Talk to a real person.</h1>
        <p class="contact__lead">
          Questions about a CallCatcher Site? Call or text. Or fill in the form and we'll build yours free, so you can
          see it before you decide.
        </p>
        <ul class="contact__list">
          <li><Icon name="phone" /><a href={site.phone.href}>{site.phone.display}</a></li>
          <li><Icon name="message" /><a href={site.phone.sms}>Text {site.phone.display}</a></li>
          <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="pin" /><span>{addressLine}</span></li>
        </ul>
      </div>
      <div class="contact__card">
        <LeadForm id="contact-form" />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr 560px;
      gap: 64px;
    }
  }

  .contact h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 800;
  }

  .contact__lead {
    margin-top: 16px;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .contact__list {
    display: grid;
    gap: 14px;
    margin-top: 28px;
    font-size: 1.05rem;
  }

  .contact__list li {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .contact__list :global(svg) {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--green);
  }

  .contact__list a {
    font-weight: 600;
    text-decoration: none;
  }

  .contact__list a:hover {
    text-decoration: underline;
  }

  .contact__card {
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
</style>
