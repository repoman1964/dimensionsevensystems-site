---
import Legal from "../layouts/Legal.astro";
import { site } from "../data/site";

const toc = [
  { id: "overview", label: "Overview" },
  { id: "collect", label: "Information we collect" },
  { id: "use", label: "How we use information" },
  { id: "sms", label: "Text messaging" },
  { id: "share", label: "Sharing" },
  { id: "retention", label: "Retention" },
  { id: "security", label: "Security" },
  { id: "rights", label: "Your choices" },
  { id: "children", label: "Children" },
  { id: "changes", label: "Changes" },
  { id: "contact", label: "Contact" },
];
---

<Legal
  title="Privacy Policy"
  description={`Privacy Policy for ${site.name}, including how we handle phone numbers and text messaging consent.`}
  updated={site.legal.privacyUpdated}
  toc={toc}
>
  <section id="overview">
    <h2>Overview</h2>
    <p>
      This Privacy Policy explains how {site.legalEntity} (“{site.name}”, “D7”, “we”, “us”) collects, uses, and
      protects information when you visit {site.url}, ask us to build a website for your business, contact us, receive
      text messages from us, or use our services.
    </p>
  </section>

  <section id="collect">
    <h2>Information we collect</h2>
    <ul>
      <li>
        <strong>Information you give us:</strong> your name, business name, trade, city, email address, phone number,
        and anything you tell us through our website form, by phone, by email, or by text.
      </li>
      <li>
        <strong>Public business information:</strong> to build a website for your business, we use information your
        business has published, such as your Google Business Profile listing, services, hours, photos, and public
        customer reviews.
      </li>
      <li>
        <strong>Text messaging information:</strong> your mobile number, the date, time, and method of your opt-in, and
        your opt-out requests.
      </li>
      <li>
        <strong>Technical information:</strong> basic data your browser sends automatically, such as browser type,
        device type, and pages visited, collected by our hosting provider to keep the site running and secure.
      </li>
    </ul>
  </section>

  <section id="use">
    <h2>How we use information</h2>
    <ul>
      <li>To build and show you a website for your business that you asked for</li>
      <li>To respond to your inquiries and requests</li>
      <li>To schedule calls with you</li>
      <li>To send text messages you have agreed to receive</li>
      <li>To provide, support, and improve our services</li>
      <li>To keep records of consent and opt-out requests</li>
      <li>To meet legal obligations</li>
    </ul>
  </section>

  <section id="sms">
    <h2>Text messaging (SMS)</h2>
    <p>
      If you agree to receive text messages from {site.name}, we use your mobile number only to send the messages you
      agreed to receive, such as the link to the website we built for you, replies to your questions, and scheduling
      messages. Message frequency varies. Message and data rates may apply. You can reply STOP at any time to opt out or
      HELP for help. See our <a href="/sms">SMS Terms</a> for full details.
    </p>
    <p class="notice">
      No mobile information will be shared with third parties or affiliates for marketing or promotional purposes. All
      the categories above exclude text messaging originator opt-in data and consent; this information will not be
      shared with any third parties.
    </p>
  </section>

  <section id="share">
    <h2>Sharing</h2>
    <p>
      We do not sell, rent, or trade your personal information. We share information only with service providers that
      help us run our business (for example, website hosting, email delivery, payment processing, and text message
      delivery), and only as needed for them to provide those services to us. These providers may not use your
      information for their own purposes. We may also disclose information if required by law.
    </p>
    <p>Phone numbers and text messaging opt-in data and consent are never shared with third parties for marketing purposes.</p>
  </section>

  <section id="retention">
    <h2>Retention</h2>
    <p>
      We keep information only as long as needed for the purposes above or as required by law. If you decide not to buy
      a website we built for you, we take it down. We keep records of text messaging consent and opt-out requests so we
      can honor them.
    </p>
  </section>

  <section id="security">
    <h2>Security</h2>
    <p>
      We use reasonable measures to protect your information, including encrypted (HTTPS) connections to this website.
      Payments are processed by Stripe; we never see or store your full card number. No method of transmission or
      storage is completely secure.
    </p>
  </section>

  <section id="rights">
    <h2>Your choices and rights</h2>
    <p>
      You can ask us to access, correct, or delete your personal information, take down a website we built for your
      business, or stop contacting you, by emailing or calling us using the details below. To stop text messages, reply
      STOP to any message.
    </p>
  </section>

  <section id="children">
    <h2>Children</h2>
    <p>Our website and services are intended for adults and businesses. We do not knowingly collect information from children under 13.</p>
  </section>

  <section id="changes">
    <h2>Changes to this policy</h2>
    <p>We may update this policy from time to time. The “Last updated” date at the top shows when it was last changed.</p>
  </section>
</Legal>
