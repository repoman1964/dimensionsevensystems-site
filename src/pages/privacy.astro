---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const toc = [
  { id: "overview", label: "Overview" },
  { id: "collect", label: "Information we collect" },
  { id: "use", label: "How we use information" },
  { id: "share", label: "Sharing" },
  { id: "retention", label: "Retention" },
  { id: "rights", label: "Your rights" },
  { id: "contact", label: "Contact" },
];
---

<BaseLayout
  title="Privacy Policy"
  description={`Privacy Policy for ${site.name}. Placeholder legal content, replace before production launch.`}
>
  <div class="legal">
    <aside class="legal__toc" aria-label="Table of contents">
      <p class="legal__toc-title">On this page</p>
      <nav>
        <ul>
          {
            toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
    <article class="legal__content">
      <p class="legal__eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="legal__updated">Last updated: {site.legal.privacyUpdated}</p>
      <p class="legal__banner">
        [PLACEHOLDER] This is scaffold legal copy for layout only. Have counsel
        review and replace before launch.
      </p>

      <section id="overview">
        <h2>Overview</h2>
        <p>
          [PLACEHOLDER] {site.name} (“D7”, “we”, “us”) respects your privacy.
          This policy describes how we handle information when you use
          {site.url} and related services, including the Conversion Review form.
        </p>
      </section>

      <section id="collect">
        <h2>Information we collect</h2>
        <p>
          [PLACEHOLDER] We may collect information you submit (name, email,
          company, phone, and messages), technical data such as browser type and
          approximate location, and analytics events if you enable a provider later.
        </p>
      </section>

      <section id="use">
        <h2>How we use information</h2>
        <p>
          [PLACEHOLDER] To respond to inquiries, schedule reviews, deliver
          services, improve the website, and meet legal obligations.
        </p>
      </section>

      <section id="share">
        <h2>Sharing</h2>
        <p>
          [PLACEHOLDER] We do not sell personal information. We may use
          processors (hosting, email delivery, scheduling) under appropriate
          agreements.
        </p>
      </section>

      <section id="retention">
        <h2>Retention</h2>
        <p>
          [PLACEHOLDER] We retain information only as long as needed for the
          purposes above or as required by law.
        </p>
      </section>

      <section id="rights">
        <h2>Your rights</h2>
        <p>
          [PLACEHOLDER] Depending on your location, you may have rights to
          access, correct, delete, or restrict processing of your personal
          information. Contact us to exercise these rights.
        </p>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>
          [PLACEHOLDER] Questions about this policy:
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .legal {
    display: grid;
    gap: 2rem;
    max-width: var(--container);
    margin-inline: auto;
    padding: 3rem 24px 5rem;
  }

  @media (min-width: 900px) {
    .legal {
      grid-template-columns: 200px 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  .legal__toc {
    display: none;
  }

  @media (min-width: 900px) {
    .legal__toc {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .legal__toc-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
    margin-bottom: 0.75rem;
  }

  .legal__toc ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .legal__toc a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .legal__toc a:hover {
    color: var(--color-text);
  }

  .legal__content {
    max-width: 42rem;
  }

  .legal__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
    margin-bottom: 0.5rem;
  }

  .legal__content h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.5rem;
  }

  .legal__updated {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
    margin-bottom: 1.25rem;
  }

  .legal__banner {
    padding: 0.85rem 1rem;
    border: 1px dashed var(--color-warning);
    border-radius: 10px;
    background: rgba(242, 185, 59, 0.08);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: 2rem;
    line-height: 1.55;
  }

  .legal__content section {
    margin-bottom: 2rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .legal__content h2 {
    font-size: var(--text-xl);
    margin-bottom: 0.75rem;
  }

  .legal__content p {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .legal__content a {
    color: var(--color-primary-hover);
  }
</style>
