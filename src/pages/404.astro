---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <section class="section">
    <div class="container" style="text-align:center; max-width:640px">
      <span class="eyebrow">404</span>
      <h1 style="font-size:clamp(2rem,4vw,2.75rem); font-weight:800">That page isn't here.</h1>
      <p style="margin:16px 0 28px; color:var(--ink-muted)">It may have moved when we rebuilt the site.</p>
      <a class="btn btn--primary" href="/">Go to the homepage</a>
    </div>
  </section>
</Base>
